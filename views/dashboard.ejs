<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - ThoughtStream</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" href="/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; min-height: 100vh; background: #ffffff; color: #1a1a2e; }
        .container { max-width: 700px; margin: 0 auto; padding: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 25px 0; }
        .logo { display: flex; align-items: center; gap: 12px; }
        .logo-icon { width: 48px; height: 48px; background: linear-gradient(135deg, #a855f7, #ec4899); border-radius: 16px; display: flex; align-items: center; justify-content: center; }
        .logo-icon i { font-size: 26px; color: white; }
        .logo-text { font-size: 24px; font-weight: 700; background: linear-gradient(135deg, #a855f7, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .user-info { display: flex; align-items: center; gap: 15px; }
        .user-avatar { width: 48px; height: 48px; background: linear-gradient(135deg, #a855f7, #ec4899); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 18px; overflow: hidden; }
        .user-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .user-name { font-weight: 600; color: #374151; }
        .btn-settings { width: 48px; height: 48px; background: #f3f4f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #6b7280; font-size: 22px; text-decoration: none; transition: all 0.3s; }
        .btn-settings:hover { color: #a855f7; transform: rotate(90deg); }
        
        .welcome-section { text-align: center; padding: 50px 0 45px; }
        .welcome-text { font-size: 36px; font-weight: 700; color: #1a1a2e; margin-bottom: 10px; }
        .welcome-text span { background: linear-gradient(135deg, #a855f7, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .welcome-subtext { color: #9ca3af; }
        .thought-input-box { background: rgba(255,255,255,0.8); border-radius: 50px; padding: 8px 10px 8px 28px; box-shadow: 0 8px 32px rgba(168,85,247,0.12), 0 4px 16px rgba(236,72,153,0.08); border: 1px solid rgba(168,85,247,0.1); }
        .thought-form { display: flex; align-items: center; gap: 12px; }
        .thought-input { flex: 1; border: none; background: transparent; padding: 18px 0; font-size: 16px; color: #1a1a2e; outline: none; font-family: inherit; }
        .thought-input::placeholder { color: #b4b4b4; }
        .btn-post { width: 52px; height: 52px; background: #f3f4f6; color: #9ca3af; border: none; border-radius: 50%; font-size: 20px; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; }
        .btn-post:hover { background: linear-gradient(135deg, #a855f7, #ec4899); color: white; }
        .feed-section { margin-top: 50px; }
        .feed-header { display: flex; align-items: center; gap: 12px; margin-bottom: 25px; }
        .feed-title { font-size: 18px; font-weight: 600; color: #374151; }
        .feed-count { background: linear-gradient(135deg, #a855f7, #ec4899); color: white; padding: 5px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; }
        .thoughts-feed { display: flex; flex-direction: column; gap: 18px; }
        .thought-card { background: #fff; border-radius: 20px; padding: 24px; border: 1px solid #f3f4f6; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
        .thought-card:hover { box-shadow: 0 8px 30px rgba(168,85,247,0.1); }
        .own-thought { border-left: 3px solid #a855f7; }
        .card-header { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
        .card-avatar { width: 46px; height: 46px; background: linear-gradient(135deg, #a855f7, #ec4899); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; overflow: hidden; }
        .card-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .card-user-name { font-weight: 600; color: #1a1a2e; }
        .you-badge { color: #a855f7; font-size: 12px; margin-left: 5px; }
        .card-timestamp { font-size: 13px; color: #b4b4b4; margin-top: 2px; }
        .card-message { font-size: 15px; line-height: 1.7; color: #4b5563; margin-bottom: 18px; }
        .card-actions { display: flex; align-items: center; gap: 8px; padding-top: 16px; border-top: 1px solid #f3f4f6; }
        .action-btn { display: flex; align-items: center; gap: 6px; background: #f9fafb; border: 1px solid #f3f4f6; color: #9ca3af; font-size: 13px; cursor: pointer; padding: 9px 14px; border-radius: 12px; transition: all 0.3s; font-family: inherit; }
        .action-btn:hover { background: rgba(168,85,247,0.08); color: #a855f7; }
        .action-btn i { font-size: 17px; }
        .action-btn.liked { background: rgba(239,68,68,0.08); color: #ef4444; }
        .action-btn.delete-btn { margin-left: auto; }
        .action-btn.delete-btn:hover { background: rgba(239,68,68,0.08); color: #ef4444; }
        .replies-container { display: none; margin-top: 15px; padding-top: 15px; border-top: 1px solid #f3f4f6; }
        .replies-container.show { display: block; }
        .reply-item { display: flex; gap: 12px; padding: 12px; background: #f9fafb; border-radius: 12px; margin-bottom: 10px; }
        .reply-avatar { width: 32px; height: 32px; background: linear-gradient(135deg, #a855f7, #ec4899); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 12px; overflow: hidden; }
        .reply-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .reply-user-name { font-weight: 600; font-size: 13px; color: #1a1a2e; }
        .reply-text { font-size: 14px; color: #6b7280; margin-top: 3px; }
        .reply-time { font-size: 11px; color: #b4b4b4; margin-top: 5px; }
        .reply-form { display: flex; gap: 10px; margin-top: 12px; }
        .reply-input { flex: 1; padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 25px; font-size: 14px; outline: none; }
        .reply-input:focus { border-color: #a855f7; }
        .btn-reply-submit { padding: 12px 20px; background: linear-gradient(135deg, #a855f7, #ec4899); color: white; border: none; border-radius: 25px; font-size: 13px; font-weight: 600; cursor: pointer; }
        .empty-state { text-align: center; padding: 80px 20px; }
        .empty-icon { width: 80px; height: 80px; background: rgba(168,85,247,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
        .empty-icon i { font-size: 36px; color: #a855f7; }
        .empty-title { font-size: 20px; font-weight: 600; color: #1a1a2e; margin-bottom: 8px; }
        .empty-text { color: #9ca3af; }
        @media (max-width: 600px) {
            .header { flex-wrap: wrap; gap: 15px; }
            .user-info { width: 100%; justify-content: space-between; }
            .welcome-text { font-size: 28px; }
            .thought-input-box { border-radius: 25px; padding: 6px 8px 6px 18px; }
            .card-actions { flex-wrap: wrap; }
            .action-btn.delete-btn { margin-left: 0; }
            .reply-form { flex-direction: column; }
            .btn-reply-submit { width: 100%; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="logo">
                <div class="logo-icon"><i class="ri-bubble-chart-fill"></i></div>
                <span class="logo-text">ThoughtStream</span>
            </div>
            <div class="user-info">
                <div class="user-avatar">
                    <% if (profilePic && profilePic.startsWith('http')) { %>
                        <img src="<%= profilePic %>" alt="Profile">
                    <% } else if (profilePic) { %>
                        <img src="/uploads/<%= profilePic %>" alt="Profile">
                    <% } else { %>
                        <%= name.charAt(0).toUpperCase() %>
                    <% } %>
                </div>
                <span class="user-name"><%= name %></span>
                <a href="/settings" class="btn-settings"><i class="ri-settings-3-line"></i></a>
            </div>

            <div class="user-info">
    <div class="user-avatar">
        <!-- existing code -->
    </div>
    <span class="user-name"><%= name %></span>
    <% if (isAdmin) { %>
        <a href="/admin" class="btn-settings" style="background: #fef2f2; color: #ef4444;" title="Admin Panel"><i class="ri-shield-keyhole-line"></i></a>
    <% } %>
    <a href="/settings" class="btn-settings"><i class="ri-settings-3-line"></i></a>
</div>
        </header>

        <!-- Welcome -->
        <section class="welcome-section">
            <h1 class="welcome-text">Welcome back, <span><%= name.split(' ')[0] %></span> ✨</h1>
            <p class="welcome-subtext">Share your thoughts with the world</p>
        </section>

        <!-- Input Box -->
        <section>
            <div class="thought-input-box">
                <form class="thought-form" method="POST" action="/add-thought">
                    <input type="text" name="thought" class="thought-input" placeholder="What's on your mind?" autocomplete="off" maxlength="280" required>
                    <button type="submit" class="btn-post"><i class="ri-send-plane-fill"></i></button>
                </form>
            </div>
        </section>

        <!-- Feed -->
        <section class="feed-section">
            <div class="feed-header">
                <h2 class="feed-title"><i class="ri-global-line" style="color:#a855f7;margin-right:8px;"></i>Global Feed</h2>
                <span class="feed-count"><%= thoughts.length %> thoughts</span>
            </div>

            <% if (thoughts.length > 0) { %>
                <div class="thoughts-feed">
                    <% for (var i = 0; i < thoughts.length; i++) { %>
                        <% var thought = thoughts[i]; %>
                        <article class="thought-card <% if (thought.userEmail === email) { %>own-thought<% } %>">
                            <div class="card-header">
                                <div class="card-avatar">
                                    <% if (thought.profilePic && thought.profilePic.startsWith('http')) { %>
                                        <img src="<%= thought.profilePic %>" alt="">
                                    <% } else if (thought.profilePic) { %>
                                        <img src="/uploads/<%= thought.profilePic %>" alt="">
                                    <% } else { %>
                                        <%= thought.userName.charAt(0).toUpperCase() %>
                                    <% } %>
                                </div>
                                <div>
                                    <div class="card-user-name">
                                        <%= thought.userName %>
                                        <% if (thought.userEmail === email) { %>
                                            <span class="you-badge">(You)</span>
                                        <% } %>
                                    </div>
                                    <div class="card-timestamp"><%= new Date(thought.timestamp).toLocaleString() %></div>
                                </div>
                            </div>

                            <p class="card-message"><%= thought.message %></p>

                            <div class="card-actions">
                                <!-- Like -->
                                <form method="POST" action="/like-thought" style="margin:0;">
                                    <input type="hidden" name="thoughtId" value="<%= thought.id %>">
                                    <button type="submit" class="action-btn <% if (thought.likedBy && thought.likedBy.includes(email)) { %>liked<% } %>">
                                        <i class="<% if (thought.likedBy && thought.likedBy.includes(email)) { %>ri-heart-fill<% } else { %>ri-heart-line<% } %>"></i>
                                        <%= thought.likedBy ? thought.likedBy.length : 0 %>
                                    </button>
                                </form>

                                <!-- Comment Toggle -->
                                <button type="button" class="action-btn" onclick="toggleReplies('<%= thought.id %>')">
                                    <i class="ri-chat-3-line"></i>
                                    <%= thought.replies ? thought.replies.length : 0 %>
                                </button>

                                <!-- Delete -->
                                <% if (thought.userEmail === email) { %>
                                    <form method="POST" action="/delete-thought" style="margin:0;">
                                        <input type="hidden" name="thoughtId" value="<%= thought.id %>">
                                        <input type="hidden" name="thoughtUserEmail" value="<%= thought.userEmail %>">
                                        <button type="submit" class="action-btn delete-btn" onclick="return confirm('Delete this thought?')">
                                            <i class="ri-delete-bin-line"></i>
                                        </button>
                                    </form>
                                <% } %>
                            </div>

                            <!-- Replies -->
                            <div id="replies-<%= thought.id %>" class="replies-container">
                                <% if (thought.replies && thought.replies.length > 0) { %>
                                    <% for (var j = 0; j < thought.replies.length; j++) { %>
                                        <% var reply = thought.replies[j]; %>
                                        <div class="reply-item">
                                            <div class="reply-avatar">
                                                <% if (reply.profilePic && reply.profilePic.startsWith('http')) { %>
                                                    <img src="<%= reply.profilePic %>" alt="">
                                                <% } else if (reply.profilePic) { %>
                                                    <img src="/uploads/<%= reply.profilePic %>" alt="">
                                                <% } else { %>
                                                    <%= reply.userName.charAt(0).toUpperCase() %>
                                                <% } %>
                                            </div>
                                            <div>
                                                <div class="reply-user-name"><%= reply.userName %></div>
                                                <div class="reply-text"><%= reply.text %></div>
                                                <div class="reply-time"><%= new Date(reply.timestamp).toLocaleString() %></div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } %>

                                <!-- Reply Form -->
                                <form class="reply-form" method="POST" action="/reply/<%= thought.id %>">
                                    <input type="text" name="replyText" class="reply-input" placeholder="Write a reply..." required maxlength="200">
                                    <button type="submit" class="btn-reply-submit"><i class="ri-reply-line"></i> Reply</button>
                                </form>
                            </div>
                        </article>
                    <% } %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-icon"><i class="ri-chat-smile-3-line"></i></div>
                    <h3 class="empty-title">No thoughts yet</h3>
                    <p class="empty-text">Be the first to share something!</p>
                </div>
            <% } %>
        </section>
    </div>

    <script>
        function toggleReplies(id) {
            var el = document.getElementById('replies-' + id);
            el.classList.toggle('show');
        }

        // Check auth status every 2 seconds
        setInterval(function() {
            fetch('/api/auth-status')
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (!data.isLoggedIn) {
                        window.location.href = '/login';
                    }
                })
                .catch(function() {});
        }, 2000);
    </script>
</body>
</html>