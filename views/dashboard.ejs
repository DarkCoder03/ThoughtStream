<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - ThoughtStream</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" href="/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            font-family: 'Inter', sans-serif; 
            min-height: 100vh; 
            background: linear-gradient(180deg, #f8f9fa 0%, #f3e8ff 50%, #fce7f3 100%);
            background-attachment: fixed;
            color: #1a1a2e; 
        }

        /* ==================== ANIMATIONS ==================== */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes scaleIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-5px); }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        @keyframes shimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        @keyframes heartBurst {
            0% { transform: scale(0); opacity: 1; }
            50% { transform: scale(1.5); opacity: 1; }
            100% { transform: scale(2); opacity: 0; }
        }

        @keyframes heartPop {
            0% { transform: scale(1); }
            25% { transform: scale(1.3); }
            50% { transform: scale(0.9); }
            75% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        @keyframes ripple {
            0% { transform: scale(0); opacity: 0.5; }
            100% { transform: scale(4); opacity: 0; }
        }

        @keyframes glow {
            0%, 100% { box-shadow: 0 0 5px rgba(168, 85, 247, 0.2); }
            50% { box-shadow: 0 0 20px rgba(168, 85, 247, 0.4), 0 0 30px rgba(236, 72, 153, 0.2); }
        }

        @keyframes typing {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 1; }
        }

        @keyframes bounceIn {
            0% { transform: scale(0.3); opacity: 0; }
            50% { transform: scale(1.05); }
            70% { transform: scale(0.9); }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        /* ==================== TOP NAV ==================== */
        .top-nav { 
            background: rgba(255, 255, 255, 0.95); 
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(229, 231, 235, 0.5); 
            padding: 12px 20px; 
            position: sticky; 
            top: 0; 
            z-index: 100;
            animation: fadeInDown 0.5s ease;
        }

        .top-nav-container { 
            max-width: 700px; 
            margin: 0 auto; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
        }

        .logo { 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            text-decoration: none;
            transition: transform 0.3s ease;
        }

        .logo:hover { transform: scale(1.02); }

        .logo-icon { 
            width: 40px; 
            height: 40px; 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            border-radius: 12px; 
            display: flex; 
            align-items: center; 
            justify-content: center;
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.3);
            transition: all 0.3s ease;
        }

        .logo:hover .logo-icon {
            transform: rotate(10deg);
            box-shadow: 0 6px 20px rgba(168, 85, 247, 0.4);
        }

        .logo-icon i { 
            font-size: 22px; 
            color: white;
            animation: float 3s ease-in-out infinite;
        }

        .logo-text { 
            font-size: 20px; 
            font-weight: 700; 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
        }

        .nav-actions { 
            display: flex; 
            align-items: center; 
            gap: 10px; 
        }

        .user-avatar { 
            width: 38px; 
            height: 38px; 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-weight: 600; 
            font-size: 15px; 
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 2px 10px rgba(168, 85, 247, 0.2);
        }

        .user-avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);
        }

        .user-avatar img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .user-avatar:hover img { transform: scale(1.1); }

        .nav-btn { 
            width: 38px; 
            height: 38px; 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-size: 20px; 
            text-decoration: none; 
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .btn-settings { 
            background: #f3f4f6; 
            color: #6b7280; 
        }

        .btn-settings:hover { 
            color: #a855f7; 
            background: #ede9fe;
            transform: rotate(90deg) scale(1.1);
        }

        .btn-admin { 
            background: #fef2f2; 
            color: #ef4444; 
        }

        .btn-admin:hover { 
            background: #fee2e2;
            transform: scale(1.1);
            animation: pulse 0.5s ease;
        }

        /* ==================== CONTAINER ==================== */
        .container { 
            max-width: 700px; 
            margin: 0 auto; 
            padding: 20px; 
        }

        /* ==================== WELCOME SECTION ==================== */
        .welcome-section { 
            text-align: center; 
            padding: 50px 0 40px;
            animation: fadeInUp 0.6s ease;
        }

        .welcome-text { 
            font-size: 36px; 
            font-weight: 700; 
            color: #1a1a2e; 
            margin-bottom: 10px;
        }

        .welcome-text span { 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
            display: inline-block;
            animation: float 3s ease-in-out infinite;
        }

        .welcome-subtext { 
            color: #9ca3af; 
            font-size: 16px;
            animation: fadeIn 0.8s ease 0.2s both;
        }

        /* ==================== THOUGHT INPUT ==================== */
        .thought-input-box { 
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 50px; 
            padding: 8px 12px 8px 28px; 
            box-shadow: 0 8px 32px rgba(168, 85, 247, 0.1);
            border: 2px solid rgba(168, 85, 247, 0.1);
            transition: all 0.4s ease;
            animation: fadeInUp 0.6s ease 0.1s both;
        }

        .thought-input-box:focus-within {
            border-color: rgba(168, 85, 247, 0.3);
            box-shadow: 0 12px 40px rgba(168, 85, 247, 0.15), 0 0 0 4px rgba(168, 85, 247, 0.05);
            transform: translateY(-2px);
        }

        .thought-form { 
            display: flex; 
            align-items: center; 
            gap: 12px; 
        }

        .thought-input { 
            flex: 1; 
            border: none; 
            background: transparent; 
            padding: 16px 0; 
            font-size: 16px; 
            color: #1a1a2e; 
            outline: none; 
            font-family: inherit; 
        }

        .thought-input::placeholder { 
            color: #b4b4b4;
            transition: color 0.3s ease;
        }

        .thought-input:focus::placeholder {
            color: #d1d5db;
        }

        .btn-post { 
            width: 50px; 
            height: 50px; 
            background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
            color: #9ca3af; 
            border: none; 
            border-radius: 50%; 
            font-size: 20px; 
            cursor: pointer; 
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex; 
            align-items: center; 
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .btn-post::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.4s ease, height 0.4s ease;
        }

        .btn-post:hover::before {
            width: 100%;
            height: 100%;
        }

        .btn-post:hover { 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            color: white;
            transform: scale(1.1) rotate(15deg);
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.4);
        }

        .btn-post:active {
            transform: scale(0.95);
        }

        /* ==================== FEED SECTION ==================== */
        .feed-section { 
            margin-top: 45px;
            animation: fadeInUp 0.6s ease 0.2s both;
        }

        .feed-header { 
            display: flex; 
            align-items: center; 
            gap: 14px; 
            margin-bottom: 25px;
        }

        .feed-title { 
            font-size: 18px; 
            font-weight: 600; 
            color: #374151; 
            display: flex; 
            align-items: center; 
            gap: 10px;
        }

        .feed-title i { 
            color: #a855f7;
            animation: pulse 2s ease-in-out infinite;
        }

        .feed-count { 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            color: white; 
            padding: 6px 14px; 
            border-radius: 25px; 
            font-size: 13px; 
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.3);
            animation: bounceIn 0.6s ease;
        }

        /* ==================== THOUGHT CARDS ==================== */
        .thoughts-feed { 
            display: flex; 
            flex-direction: column; 
            gap: 20px; 
        }

        .thought-card { 
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 20px; 
            padding: 24px; 
            border: 1px solid rgba(229, 231, 235, 0.5);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            animation: fadeInUp 0.5s ease both;
            position: relative;
            overflow: hidden;
        }

        .thought-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.03), rgba(236, 72, 153, 0.03));
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }

        .thought-card:hover::before {
            opacity: 1;
        }

        .thought-card:hover { 
            transform: translateY(-5px);
            box-shadow: 
                0 20px 50px rgba(168, 85, 247, 0.12),
                0 0 0 1px rgba(168, 85, 247, 0.1),
                inset 0 0 60px rgba(168, 85, 247, 0.02);
            border-color: rgba(168, 85, 247, 0.2);
        }

        .thought-card:nth-child(1) { animation-delay: 0.1s; }
        .thought-card:nth-child(2) { animation-delay: 0.2s; }
        .thought-card:nth-child(3) { animation-delay: 0.3s; }
        .thought-card:nth-child(4) { animation-delay: 0.4s; }
        .thought-card:nth-child(5) { animation-delay: 0.5s; }

        .own-thought { 
            border-left: 4px solid;
            border-image: linear-gradient(135deg, #a855f7, #ec4899) 1;
        }

        /* Card Header */
        .card-header { 
            display: flex; 
            align-items: center; 
            gap: 14px; 
            margin-bottom: 16px;
        }

        .card-avatar { 
            width: 46px; 
            height: 46px; 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-weight: 600; 
            overflow: hidden; 
            font-size: 18px;
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.2);
            transition: all 0.3s ease;
        }

        .thought-card:hover .card-avatar {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(168, 85, 247, 0.3);
        }

        .card-avatar img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover;
        }

        .card-user-info { flex: 1; }

        .card-user-name { 
            font-weight: 600; 
            color: #1a1a2e; 
            font-size: 16px;
            transition: color 0.3s ease;
        }

        .thought-card:hover .card-user-name {
            color: #a855f7;
        }

        .you-badge { 
            color: #a855f7; 
            font-size: 12px; 
            margin-left: 6px;
            font-weight: 500;
            background: rgba(168, 85, 247, 0.1);
            padding: 2px 8px;
            border-radius: 10px;
        }

        .card-timestamp { 
            font-size: 13px; 
            color: #9ca3af; 
            margin-top: 3px;
        }

        .card-message { 
            font-size: 16px; 
            line-height: 1.7; 
            color: #374151; 
            margin-bottom: 18px;
            transition: color 0.3s ease;
        }

        /* ==================== CARD ACTIONS ==================== */
        .card-actions { 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            padding-top: 16px; 
            border-top: 1px solid rgba(243, 244, 246, 0.8);
        }

        .action-btn { 
            display: flex; 
            align-items: center; 
            gap: 6px; 
            background: rgba(249, 250, 251, 0.8);
            border: 1px solid rgba(243, 244, 246, 0.8);
            color: #9ca3af; 
            font-size: 14px; 
            cursor: pointer; 
            padding: 10px 16px; 
            border-radius: 12px; 
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-family: inherit;
            position: relative;
            overflow: hidden;
        }

        .action-btn i { 
            font-size: 18px;
            transition: transform 0.3s ease;
        }

        .action-btn:hover { 
            background: rgba(168, 85, 247, 0.08);
            color: #a855f7;
            border-color: rgba(168, 85, 247, 0.2);
            transform: translateY(-2px);
        }

        .action-btn:hover i {
            transform: scale(1.15);
        }

        .action-btn:active {
            transform: translateY(0) scale(0.95);
        }

        /* Like Button Special */
        .like-btn {
            position: relative;
        }

        .like-btn.liked { 
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.2);
        }

        .like-btn.liked i {
            animation: heartPop 0.5s ease;
        }

        .like-btn:hover:not(.liked) {
            background: rgba(239, 68, 68, 0.08);
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.2);
        }

        /* Heart Burst Effect */
        .heart-burst {
            position: fixed;
            pointer-events: none;
            z-index: 9999;
        }

        .heart-burst i {
            font-size: 40px;
            color: #ef4444;
            animation: heartBurst 0.8s ease forwards;
        }

        .heart-particles {
            position: absolute;
            width: 10px;
            height: 10px;
            background: #ef4444;
            border-radius: 50%;
            animation: heartBurst 0.6s ease forwards;
        }

        /* Delete Button */
        .delete-btn { 
            margin-left: auto;
        }

        .delete-btn:hover { 
            background: rgba(239, 68, 68, 0.08);
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.2);
        }

        .delete-btn:hover i {
            animation: shake 0.3s ease;
        }

        /* ==================== REPLIES ==================== */
        .replies-container { 
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .replies-container.show { 
            max-height: 2000px;
            opacity: 1;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid rgba(243, 244, 246, 0.8);
        }

        .reply-item { 
            display: flex; 
            gap: 12px; 
            padding: 14px; 
            background: rgba(249, 250, 251, 0.8);
            border-radius: 14px; 
            margin-bottom: 12px;
            animation: fadeInUp 0.3s ease both;
            transition: all 0.3s ease;
        }

        .reply-item:hover {
            background: rgba(243, 244, 246, 0.9);
            transform: translateX(5px);
        }

        .reply-avatar { 
            width: 34px; 
            height: 34px; 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-size: 12px; 
            overflow: hidden;
            flex-shrink: 0;
        }

        .reply-avatar img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover;
        }

        .reply-content { flex: 1; }

        .reply-user-name { 
            font-weight: 600; 
            font-size: 14px; 
            color: #1a1a2e;
        }

        .reply-text { 
            font-size: 14px; 
            color: #6b7280; 
            margin-top: 4px;
            line-height: 1.5;
        }

        .reply-time { 
            font-size: 12px; 
            color: #b4b4b4; 
            margin-top: 6px;
        }

        .reply-form { 
            display: flex; 
            gap: 12px; 
            margin-top: 14px;
            animation: fadeIn 0.3s ease 0.2s both;
        }

        .reply-input { 
            flex: 1; 
            padding: 12px 18px; 
            border: 2px solid #e5e7eb;
            border-radius: 25px; 
            font-size: 14px; 
            outline: none; 
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .reply-input:focus { 
            border-color: #a855f7;
            box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.1);
        }

        .btn-reply-submit { 
            padding: 12px 22px; 
            background: linear-gradient(135deg, #a855f7, #ec4899); 
            color: white; 
            border: none; 
            border-radius: 25px; 
            font-size: 14px; 
            font-weight: 600; 
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.3);
        }

        .btn-reply-submit:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.4);
        }

        /* ==================== EMPTY STATE ==================== */
        .empty-state { 
            text-align: center; 
            padding: 80px 20px;
            animation: fadeInUp 0.6s ease;
        }

        .empty-icon { 
            width: 80px; 
            height: 80px; 
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.1), rgba(236, 72, 153, 0.1));
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            margin: 0 auto 20px;
            animation: float 3s ease-in-out infinite;
        }

        .empty-icon i { 
            font-size: 36px; 
            color: #a855f7;
        }

        .empty-title { 
            font-size: 20px; 
            font-weight: 600; 
            color: #1a1a2e; 
            margin-bottom: 8px;
        }

        .empty-text { 
            color: #9ca3af; 
            font-size: 15px;
        }

        /* ==================== FLOATING BG ==================== */
        .bg-decoration {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
            z-index: -1;
            animation: float 10s ease-in-out infinite;
        }

        .bg-decoration-1 {
            width: 400px;
            height: 400px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            top: -150px;
            right: -150px;
        }

        .bg-decoration-2 {
            width: 300px;
            height: 300px;
            background: linear-gradient(135deg, #3b82f6, #a855f7);
            bottom: -100px;
            left: -100px;
            animation-delay: 3s;
        }

        /* ==================== RESPONSIVE ==================== */
        @media (max-width: 600px) {
            .welcome-text { font-size: 28px; }
            .thought-input-box { border-radius: 30px; padding: 6px 10px 6px 20px; }
            .thought-card { padding: 20px; border-radius: 18px; }
            .card-actions { flex-wrap: wrap; gap: 8px; }
            .delete-btn { margin-left: 0; }
            .reply-form { flex-direction: column; }
            .btn-reply-submit { width: 100%; }
            .action-btn { padding: 8px 12px; font-size: 13px; }
        }
    </style>
</head>
<body>
    <!-- Background Decorations -->
    <div class="bg-decoration bg-decoration-1"></div>
    <div class="bg-decoration bg-decoration-2"></div>

    <!-- Top Navigation -->
    <nav class="top-nav">
        <div class="top-nav-container">
            <a href="/dashboard" class="logo">
                <div class="logo-icon"><i class="ri-bubble-chart-fill"></i></div>
                <span class="logo-text">ThoughtStream</span>
            </a>
            <div class="nav-actions">
                <div class="user-avatar">
                    <% if (profilePic && profilePic.startsWith('http')) { %>
                        <img src="<%= profilePic %>" alt="">
                    <% } else if (profilePic) { %>
                        <img src="/uploads/<%= profilePic %>" alt="">
                    <% } else { %>
                        <%= name.charAt(0).toUpperCase() %>
                    <% } %>
                </div>
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                    <a href="/admin" class="nav-btn btn-admin" title="Admin"><i class="ri-shield-keyhole-line"></i></a>
                <% } %>
                <a href="/settings" class="nav-btn btn-settings" title="Settings"><i class="ri-settings-3-line"></i></a>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Welcome Section -->
        <section class="welcome-section">
            <h1 class="welcome-text">Welcome back, <span><%= name.split(' ')[0] %></span> ✨</h1>
            <p class="welcome-subtext">Share your thoughts with the world</p>
        </section>

        <!-- Thought Input -->
        <section>
            <div class="thought-input-box">
                <form class="thought-form" method="POST" action="/add-thought">
                    <input type="text" name="thought" class="thought-input" placeholder="What's on your mind?" autocomplete="off" maxlength="280" required>
                    <button type="submit" class="btn-post"><i class="ri-send-plane-fill"></i></button>
                </form>
            </div>
        </section>

        <!-- Feed Section -->
        <section class="feed-section">
            <div class="feed-header">
                <h2 class="feed-title"><i class="ri-global-line"></i> Global Feed</h2>
                <span class="feed-count"><%= thoughts.length %> thoughts</span>
            </div>

            <% if (thoughts.length > 0) { %>
                <div class="thoughts-feed">
                    <% thoughts.forEach(function(thought, index) { %>
                        <article class="thought-card <% if (thought.userEmail === email) { %>own-thought<% } %>" data-index="<%= index %>">
                            <div class="card-header">
                                <div class="card-avatar">
                                    <% if (thought.profilePic && thought.profilePic.startsWith('http')) { %>
                                        <img src="<%= thought.profilePic %>" alt="">
                                    <% } else if (thought.profilePic) { %>
                                        <img src="/uploads/<%= thought.profilePic %>" alt="">
                                    <% } else { %>
                                        <%= thought.userName.charAt(0).toUpperCase() %>
                                    <% } %>
                                </div>
                                <div class="card-user-info">
                                    <div class="card-user-name">
                                        <%= thought.userName %>
                                        <% if (thought.userEmail === email) { %><span class="you-badge">You</span><% } %>
                                    </div>
                                    <div class="card-timestamp"><%= formatToIST(thought.timestamp) %></div>
                                </div>
                            </div>
                            
                            <p class="card-message"><%= thought.message %></p>
                            
                            <div class="card-actions">
                                <!-- Like Button -->
                                <form method="POST" action="/like-thought" style="margin:0;" class="like-form">
                                    <input type="hidden" name="thoughtId" value="<%= thought.id %>">
                                    <button type="submit" class="action-btn like-btn <% if (thought.likedBy && thought.likedBy.includes(email)) { %>liked<% } %>" data-liked="<%= thought.likedBy && thought.likedBy.includes(email) ? 'true' : 'false' %>">
                                        <i class="<% if (thought.likedBy && thought.likedBy.includes(email)) { %>ri-heart-fill<% } else { %>ri-heart-line<% } %>"></i>
                                        <span class="like-count"><%= thought.likedBy ? thought.likedBy.length : 0 %></span>
                                    </button>
                                </form>

                                <!-- Comment Button -->
                                <button type="button" class="action-btn comment-btn" onclick="toggleReplies('<%= thought.id %>')">
                                    <i class="ri-chat-3-line"></i>
                                    <span><%= thought.replies ? thought.replies.length : 0 %></span>
                                </button>

                                <!-- Delete Button -->
                                <% if (thought.userEmail === email || (typeof isAdmin !== 'undefined' && isAdmin)) { %>
                                    <form method="POST" action="/delete-thought" style="margin:0;">
                                        <input type="hidden" name="thoughtId" value="<%= thought.id %>">
                                        <input type="hidden" name="thoughtUserEmail" value="<%= thought.userEmail %>">
                                        <button type="submit" class="action-btn delete-btn" onclick="return confirm('Delete this thought?')">
                                            <i class="ri-delete-bin-line"></i>
                                        </button>
                                    </form>
                                <% } %>
                            </div>

                            <!-- Replies Section -->
                            <div id="replies-<%= thought.id %>" class="replies-container">
                                <% if (thought.replies && thought.replies.length > 0) { %>
                                    <% thought.replies.forEach(function(reply, replyIndex) { %>
                                        <div class="reply-item" style="animation-delay: <%= replyIndex * 0.1 %>s">
                                            <div class="reply-avatar">
                                                <% if (reply.profilePic && reply.profilePic.startsWith('http')) { %>
                                                    <img src="<%= reply.profilePic %>" alt="">
                                                <% } else if (reply.profilePic) { %>
                                                    <img src="/uploads/<%= reply.profilePic %>" alt="">
                                                <% } else { %>
                                                    <%= reply.userName.charAt(0).toUpperCase() %>
                                                <% } %>
                                            </div>
                                            <div class="reply-content">
                                                <div class="reply-user-name"><%= reply.userName %></div>
                                                <div class="reply-text"><%= reply.text %></div>
                                                <div class="reply-time"><%= formatToIST(reply.timestamp) %></div>
                                            </div>
                                            <% if (reply.userEmail === email || (typeof isAdmin !== 'undefined' && isAdmin)) { %>
                                                <form method="POST" action="/delete-reply" style="margin:0;">
                                                    <input type="hidden" name="replyId" value="<%= reply.id %>">
                                                    <input type="hidden" name="replyUserEmail" value="<%= reply.userEmail %>">
                                                    <button type="submit" class="action-btn" style="padding:6px 10px;" onclick="return confirm('Delete?')">
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    <% }); %>
                                <% } %>
                                
                                <form class="reply-form" method="POST" action="/reply/<%= thought.id %>">
                                    <input type="text" name="replyText" class="reply-input" placeholder="Write a reply..." required maxlength="200">
                                    <button type="submit" class="btn-reply-submit">
                                        <i class="ri-reply-line"></i> Reply
                                    </button>
                                </form>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-icon"><i class="ri-chat-smile-3-line"></i></div>
                    <h3 class="empty-title">No thoughts yet</h3>
                    <p class="empty-text">Be the first to share something amazing!</p>
                </div>
            <% } %>
        </section>
    </div>

    <script>
        // Toggle Replies
        function toggleReplies(id) {
            const container = document.getElementById('replies-' + id);
            container.classList.toggle('show');
        }

        // Heart Burst Animation on Like
        document.querySelectorAll('.like-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                const btn = this.querySelector('.like-btn');
                const isLiked = btn.dataset.liked === 'true';
                
                if (!isLiked) {
                    // Create heart burst effect
                    const rect = btn.getBoundingClientRect();
                    const burst = document.createElement('div');
                    burst.className = 'heart-burst';
                    burst.innerHTML = '<i class="ri-heart-fill"></i>';
                    burst.style.left = (rect.left + rect.width / 2 - 20) + 'px';
                    burst.style.top = (rect.top + rect.height / 2 - 20) + 'px';
                    document.body.appendChild(burst);

                    // Create particles
                    for (let i = 0; i < 8; i++) {
                        const particle = document.createElement('div');
                        particle.className = 'heart-particles';
                        particle.style.left = (rect.left + rect.width / 2) + 'px';
                        particle.style.top = (rect.top + rect.height / 2) + 'px';
                        particle.style.setProperty('--angle', (i * 45) + 'deg');
                        document.body.appendChild(particle);
                        
                        setTimeout(() => particle.remove(), 600);
                    }

                    // Remove burst after animation
                    setTimeout(() => burst.remove(), 800);

                    // Animate button
                    btn.style.animation = 'heartPop 0.5s ease';
                    setTimeout(() => {
                        btn.style.animation = '';
                    }, 500);
                }
            });
        });

        // Add click ripple effect to buttons
        document.querySelectorAll('.action-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                const rect = this.getBoundingClientRect();
                const ripple = document.createElement('span');
                ripple.style.cssText = `
                    position: absolute;
                    width: 10px;
                    height: 10px;
                    background: rgba(168, 85, 247, 0.3);
                    border-radius: 50%;
                    transform: translate(-50%, -50%);
                    left: ${e.clientX - rect.left}px;
                    top: ${e.clientY - rect.top}px;
                    animation: ripple 0.6s ease forwards;
                    pointer-events: none;
                `;
                this.appendChild(ripple);
                setTimeout(() => ripple.remove(), 600);
            });
        });

        // Intersection Observer for scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.thought-card').forEach(card => {
            observer.observe(card);
        });

        // Auth check
        setInterval(function() {
            fetch('/api/auth-status')
                .then(r => r.json())
                .then(d => { 
                    if (!d.isLoggedIn) window.location.href = '/login'; 
                })
                .catch(() => {});
        }, 2000);

        // Input focus animation
        document.querySelector('.thought-input').addEventListener('focus', function() {
            this.parentElement.parentElement.style.transform = 'scale(1.01)';
        });

        document.querySelector('.thought-input').addEventListener('blur', function() {
            this.parentElement.parentElement.style.transform = 'scale(1)';
        });
    </script>
</body>
</html>