<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - ThoughtStream</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; min-height: 100vh; background: #f8f9fa; color: #1a1a2e; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 25px 0; border-bottom: 1px solid #e5e7eb; margin-bottom: 30px; }
        .logo { display: flex; align-items: center; gap: 12px; }
        .logo-icon { width: 48px; height: 48px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 16px; display: flex; align-items: center; justify-content: center; }
        .logo-icon i { font-size: 26px; color: white; }
        .logo-text { font-size: 24px; font-weight: 700; color: #ef4444; }
        .header-actions { display: flex; gap: 15px; align-items: center; }
        .btn { padding: 12px 24px; border-radius: 12px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s; border: none; cursor: pointer; font-size: 14px; }
        .btn-secondary { background: #f3f4f6; color: #374151; }
        .btn-secondary:hover { background: #e5e7eb; }
        .btn-danger { background: #fef2f2; color: #ef4444; border: 1px solid #fecaca; }
        .btn-danger:hover { background: #fee2e2; }
        .tabs { display: flex; gap: 10px; margin-bottom: 30px; flex-wrap: wrap; }
        .tab { padding: 12px 24px; background: #fff; border: 2px solid #e5e7eb; border-radius: 12px; cursor: pointer; font-weight: 500; transition: all 0.3s; }
        .tab.active { background: linear-gradient(135deg, #a855f7, #ec4899); color: white; border-color: transparent; }
        .tab:hover:not(.active) { border-color: #a855f7; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .card { background: #fff; border-radius: 16px; padding: 20px; margin-bottom: 15px; border: 1px solid #e5e7eb; }
        .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; gap: 15px; flex-wrap: wrap; }
        .card-user { display: flex; align-items: center; gap: 12px; }
        .card-avatar { width: 40px; height: 40px; background: linear-gradient(135deg, #a855f7, #ec4899); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 14px; overflow: hidden; flex-shrink: 0; }
        .card-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .card-name { font-weight: 600; color: #1a1a2e; }
        .card-email { font-size: 12px; color: #9ca3af; }
        .card-time { font-size: 12px; color: #9ca3af; }
        .card-message { color: #4b5563; line-height: 1.6; margin-bottom: 12px; padding: 12px; background: #f9fafb; border-radius: 10px; }
        .card-meta { font-size: 12px; color: #9ca3af; font-style: italic; }
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: #fff; border-radius: 16px; padding: 24px; border: 1px solid #e5e7eb; text-align: center; }
        .stat-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 24px; }
        .stat-icon.purple { background: rgba(168, 85, 247, 0.1); color: #a855f7; }
        .stat-icon.pink { background: rgba(236, 72, 153, 0.1); color: #ec4899; }
        .stat-icon.blue { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
        .stat-number { font-size: 32px; font-weight: 700; color: #1a1a2e; }
        .stat-label { color: #9ca3af; font-size: 14px; }
        .table-wrapper { overflow-x: auto; }
        .user-table { width: 100%; border-collapse: collapse; min-width: 600px; }
        .user-table th, .user-table td { padding: 15px; text-align: left; border-bottom: 1px solid #e5e7eb; }
        .user-table th { background: #f9fafb; font-weight: 600; color: #374151; }
        .user-table tr:hover { background: #f9fafb; }
        .badge { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-admin { background: #fef3c7; color: #d97706; }
        .badge-user { background: #e0e7ff; color: #4f46e5; }
        .empty-state { text-align: center; padding: 60px 20px; color: #9ca3af; }
        .empty-state i { font-size: 48px; margin-bottom: 15px; }
        @media (max-width: 768px) {
            .header { flex-direction: column; gap: 15px; align-items: flex-start; }
            .header-actions { width: 100%; justify-content: space-between; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="logo">
                <div class="logo-icon"><i class="ri-shield-keyhole-line"></i></div>
                <span class="logo-text">Admin Panel</span>
            </div>
            <div class="header-actions">
                <span style="color: #6b7280; display: flex; align-items: center; gap: 8px;">
                    <i class="ri-user-line"></i> <%= adminName %>
                </span>
                <a href="/dashboard" class="btn btn-secondary"><i class="ri-arrow-left-line"></i> Back</a>
            </div>
        </header>

        <div class="stats">
            <div class="stat-card">
                <div class="stat-icon purple"><i class="ri-user-line"></i></div>
                <div class="stat-number"><%= users.length %></div>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon pink"><i class="ri-chat-3-line"></i></div>
                <div class="stat-number"><%= thoughts.length %></div>
                <div class="stat-label">Total Thoughts</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon blue"><i class="ri-reply-line"></i></div>
                <div class="stat-number"><%= replies.length %></div>
                <div class="stat-label">Total Replies</div>
            </div>
        </div>

        <div class="tabs">
            <div class="tab active" onclick="showTab('thoughts', this)"><i class="ri-chat-3-line"></i> Thoughts</div>
            <div class="tab" onclick="showTab('replies', this)"><i class="ri-reply-line"></i> Replies</div>
            <div class="tab" onclick="showTab('users', this)"><i class="ri-user-line"></i> Users</div>
        </div>

        <div id="thoughts-tab" class="tab-content active">
            <% if (thoughts.length > 0) { %>
                <% thoughts.forEach(function(thought) { %>
                    <div class="card">
                        <div class="card-header">
                            <div class="card-user">
                                <div class="card-avatar">
                                    <% if (thought.profilePic && thought.profilePic.startsWith('http')) { %>
                                        <img src="<%= thought.profilePic %>" alt="">
                                    <% } else if (thought.profilePic) { %>
                                        <img src="/uploads/<%= thought.profilePic %>" alt="">
                                    <% } else { %>
                                        <%= thought.userName.charAt(0).toUpperCase() %>
                                    <% } %>
                                </div>
                                <div>
                                    <div class="card-name"><%= thought.userName %></div>
                                    <div class="card-email"><%= thought.userEmail %></div>
                                </div>
                            </div>
                            <form method="POST" action="/delete-thought" style="margin: 0;">
                                <input type="hidden" name="thoughtId" value="<%= thought.id %>">
                                <input type="hidden" name="thoughtUserEmail" value="<%= thought.userEmail %>">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this thought?')">
                                    <i class="ri-delete-bin-line"></i> Delete
                                </button>
                            </form>
                        </div>
                        <div class="card-message"><%= thought.message %></div>
                        <div class="card-time"><i class="ri-time-line"></i> <%= formatToIST(thought.timestamp) %></div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="ri-chat-3-line"></i>
                    <p>No thoughts yet</p>
                </div>
            <% } %>
        </div>

        <div id="replies-tab" class="tab-content">
            <% if (replies.length > 0) { %>
                <% replies.forEach(function(reply) { %>
                    <div class="card">
                        <div class="card-header">
                            <div class="card-user">
                                <div class="card-avatar">
                                    <% if (reply.profilePic && reply.profilePic.startsWith('http')) { %>
                                        <img src="<%= reply.profilePic %>" alt="">
                                    <% } else if (reply.profilePic) { %>
                                        <img src="/uploads/<%= reply.profilePic %>" alt="">
                                    <% } else { %>
                                        <%= reply.userName.charAt(0).toUpperCase() %>
                                    <% } %>
                                </div>
                                <div>
                                    <div class="card-name"><%= reply.userName %></div>
                                    <div class="card-email"><%= reply.userEmail %></div>
                                </div>
                            </div>
                            <form method="POST" action="/delete-reply" style="margin: 0;">
                                <input type="hidden" name="replyId" value="<%= reply.id %>">
                                <input type="hidden" name="replyUserEmail" value="<%= reply.userEmail %>">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this reply?')">
                                    <i class="ri-delete-bin-line"></i> Delete
                                </button>
                            </form>
                        </div>
                        <div class="card-message"><%= reply.text %></div>
                        <% if (reply.thoughtMessage) { %>
                            <div class="card-meta">Reply to: "<%= reply.thoughtMessage.substring(0, 50) %><%= reply.thoughtMessage.length > 50 ? '...' : '' %>"</div>
                        <% } %>
                        <div class="card-time"><i class="ri-time-line"></i> <%= formatToIST(reply.timestamp) %></div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="ri-reply-line"></i>
                    <p>No replies yet</p>
                </div>
            <% } %>
        </div>

        <div id="users-tab" class="tab-content">
            <div class="card" style="padding: 0; overflow: hidden;">
                <div class="table-wrapper">
                    <table class="user-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(user) { %>
                                <tr>
                                    <td><%= user.id %></td>
                                    <td><%= user.name %></td>
                                    <td><%= user.email %></td>
                                    <td>
                                        <% if (user.is_admin) { %>
                                            <span class="badge badge-admin">Admin</span>
                                        <% } else { %>
                                            <span class="badge badge-user">User</span>
                                        <% } %>
                                    </td>
                                    <td><%= formatToIST(user.created_at) %></td>
                                    <td>
                                        <% if (!user.is_admin) { %>
                                            <form method="POST" action="/admin/delete-user" style="margin: 0;">
                                                <input type="hidden" name="userId" value="<%= user.id %>">
                                                <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this user and all their content?')">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span style="color: #9ca3af;">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showTab(tabName, element) {
            document.querySelectorAll('.tab-content').forEach(function(tab) {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab').forEach(function(tab) {
                tab.classList.remove('active');
            });
            document.getElementById(tabName + '-tab').classList.add('active');
            element.classList.add('active');
        }
    </script>
</body>
</html>