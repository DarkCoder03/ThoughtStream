<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ThoughtStream</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" href="/logo.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #f8f9fa;
            position: relative;
            overflow: hidden;
        }
        .bg-orb { position: fixed; border-radius: 50%; filter: blur(120px); opacity: 0.4; z-index: 0; }
        .bg-orb-1 { width: 500px; height: 500px; background: linear-gradient(135deg, #a855f7, #ec4899); top: -200px; right: -100px; }
        .bg-orb-2 { width: 400px; height: 400px; background: linear-gradient(135deg, #3b82f6, #a855f7); bottom: -150px; left: -100px; }
        .login-container {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            padding: 50px 45px;
            border-radius: 32px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02), 0 12px 40px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.9);
            width: 100%;
            max-width: 420px;
            animation: fadeInUp 0.6s ease;
            position: relative;
            z-index: 10;
        }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .logo { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 15px; }
        .logo-icon {
            width: 50px; height: 50px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.35);
        }
        .logo-icon i { font-size: 26px; color: white; }
        .logo-text { font-size: 28px; font-weight: 700; background: linear-gradient(135deg, #a855f7, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .login-container h1 { text-align: center; color: #1a1a2e; margin-bottom: 8px; font-size: 28px; font-weight: 700; }
        .login-subtitle { text-align: center; color: #6b7280; margin-bottom: 35px; font-size: 15px; }
        .form-group { margin-bottom: 22px; }
        .form-group label { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; color: #374151; font-weight: 500; font-size: 14px; }
        .form-group label i { font-size: 16px; color: #a855f7; }
        .form-group input {
            width: 100%; padding: 16px 20px;
            border: 2px solid #e5e7eb; border-radius: 16px;
            font-size: 15px; transition: all 0.3s ease;
            background: #f9fafb; color: #1a1a2e; font-family: inherit;
        }
        .form-group input::placeholder { color: #9ca3af; }
        .form-group input:focus {
            outline: none; border-color: transparent; background: #ffffff;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.15), 0 0 20px rgba(168, 85, 247, 0.1);
        }
        .btn-login {
            width: 100%; padding: 16px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            color: #ffffff; border: none; border-radius: 16px;
            font-size: 16px; font-weight: 600; cursor: pointer;
            transition: all 0.4s ease; font-family: inherit;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.35);
        }
        .btn-login:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(168, 85, 247, 0.45); }
        .btn-login i { font-size: 20px; }
        .divider { display: flex; align-items: center; margin: 28px 0; }
        .divider-line { flex: 1; height: 1px; background: #e5e7eb; }
        .divider-text { padding: 0 18px; color: #9ca3af; font-size: 13px; }
        .btn-register {
            width: 100%; padding: 16px;
            background: #f3f4f6; color: #374151;
            border: 2px solid #e5e7eb; border-radius: 16px;
            font-size: 16px; font-weight: 600; cursor: pointer;
            transition: all 0.3s ease; text-decoration: none;
            display: flex; align-items: center; justify-content: center; gap: 10px;
        }
        .btn-register:hover { background: #ffffff; border-color: #a855f7; color: #a855f7; transform: translateY(-2px); }
        .btn-register i { font-size: 20px; }
        .error-message {
            background: #fef2f2; color: #dc2626;
            padding: 14px 18px; border-radius: 14px;
            margin-bottom: 20px; text-align: center;
            font-weight: 500; font-size: 14px; border: 1px solid #fecaca;
            display: flex; align-items: center; justify-content: center; gap: 10px;
        }
        .success-message {
            background: #f0fdf4; color: #16a34a;
            padding: 14px 18px; border-radius: 14px;
            margin-bottom: 20px; text-align: center;
            font-weight: 500; font-size: 14px; border: 1px solid #bbf7d0;
            display: flex; align-items: center; justify-content: center; gap: 10px;
        }
        @media (max-width: 480px) { .login-container { margin: 20px; padding: 35px 25px; } .logo-text { font-size: 24px; } }
    </style>
</head>
<body>
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>

    <div class="login-container">
        <div class="logo">
            <div class="logo-icon"><i class="ri-bubble-chart-fill"></i></div>
            <span class="logo-text">ThoughtStream</span>
        </div>

        <h1>Welcome Back</h1>
        <p class="login-subtitle">Sign in to continue your journey</p>

        <% if (error) { %>
            <div class="error-message"><i class="ri-error-warning-line"></i><%= error %></div>
        <% } %>

        <% if (success) { %>
            <div class="success-message"><i class="ri-checkbox-circle-line"></i><%= success %></div>
        <% } %>

        <form method="POST" action="/login">
            <div class="form-group">
                <label for="email"><i class="ri-mail-line"></i> Email Address</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>

            <div class="form-group">
                <label for="password"><i class="ri-lock-line"></i> Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required>
            </div>

            <button type="submit" class="btn-login"><i class="ri-login-box-line"></i> Sign In</button>
        </form>

        <div class="divider">
            <div class="divider-line"></div>
            <span class="divider-text">New here?</span>
            <div class="divider-line"></div>
        </div>

        <a href="/register" class="btn-register"><i class="ri-user-add-line"></i> Create an Account</a>
    </div>

    <!-- Session Sync Script -->
    <script>
        // Check if user logged in from another tab
        setInterval(async () => {
            try {
                const response = await fetch('/api/auth-status');
                const data = await response.json();
                if (data.isLoggedIn) {
                    window.location.href = '/dashboard';
                }
            } catch (err) {
                console.log('Auth check failed');
            }
        }, 2000);
    </script>
</body>
</html>