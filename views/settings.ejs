<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - ThoughtStream</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            background: #f8f9fa;
            color: #1a1a2e;
        }

        .bg-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(150px);
            opacity: 0.3;
            z-index: 0;
            pointer-events: none;
        }

        .bg-orb-1 {
            width: 500px;
            height: 500px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            top: -200px;
            right: -100px;
        }

        .bg-orb-2 {
            width: 400px;
            height: 400px;
            background: linear-gradient(135deg, #3b82f6, #a855f7);
            bottom: -150px;
            left: -100px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            min-height: 100vh;
            position: relative;
            z-index: 10;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 0;
            animation: fadeInDown 0.6s ease;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .back-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: #ffffff;
            border: 2px solid #e5e7eb;
            border-radius: 30px;
            color: #374151;
            font-weight: 500;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .back-btn:hover {
            border-color: #a855f7;
            color: #a855f7;
            transform: translateX(-5px);
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.15);
        }

        .back-btn i {
            font-size: 18px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 700;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .settings-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 32px;
            padding: 40px;
            margin-top: 30px;
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02), 0 12px 40px rgba(0, 0, 0, 0.06);
            animation: fadeInUp 0.6s ease;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #1a1a2e;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title i {
            color: #a855f7;
            font-size: 22px;
        }

        .profile-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid #f3f4f6;
        }

        .profile-pic-container {
            position: relative;
            margin-bottom: 20px;
        }

        .profile-pic {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 48px;
            overflow: hidden;
            border: 4px solid #ffffff;
            box-shadow: 0 8px 30px rgba(168, 85, 247, 0.3);
        }

        .profile-pic img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-pic-overlay {
            position: absolute;
            bottom: 5px;
            right: 5px;
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 3px solid #ffffff;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.3);
        }

        .profile-pic-overlay:hover {
            transform: scale(1.1);
        }

        .profile-pic-overlay i {
            font-size: 16px;
            color: white;
        }

        .profile-name {
            font-size: 22px;
            font-weight: 600;
            color: #1a1a2e;
        }

        .profile-email {
            font-size: 14px;
            color: #6b7280;
            margin-top: 4px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: #374151;
            font-weight: 500;
            font-size: 14px;
        }

        .form-group label i {
            color: #a855f7;
        }

        .form-group input[type="text"],
        .form-group input[type="email"] {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #e5e7eb;
            border-radius: 14px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: #f9fafb;
            color: #1a1a2e;
            font-family: inherit;
        }

        .form-group input::placeholder {
            color: #9ca3af;
        }

        .form-group input:focus {
            outline: none;
            border-color: #a855f7;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
        }

        .form-group input:disabled {
            background: #f3f4f6;
            color: #9ca3af;
            cursor: not-allowed;
        }

        .form-group input[type="file"] {
            display: none;
        }

        .file-input-label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 24px;
            background: #f9fafb;
            border: 2px dashed #e5e7eb;
            border-radius: 16px;
            color: #6b7280;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 15px;
        }

        .file-input-label:hover {
            background: #ffffff;
            border-color: #a855f7;
            color: #a855f7;
        }

        .file-input-label i {
            font-size: 24px;
        }

        .file-name {
            font-size: 13px;
            color: #9ca3af;
            margin-top: 10px;
            text-align: center;
        }

        .input-hint {
            font-size: 12px;
            color: #9ca3af;
            margin-top: 6px;
        }

        .btn-save {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #a855f7, #ec4899);
            color: #ffffff;
            border: none;
            border-radius: 16px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.35);
        }

        .btn-save:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(168, 85, 247, 0.45);
        }

        .btn-save i {
            font-size: 20px;
        }

        .logout-section {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #f3f4f6;
        }

        .btn-logout {
            width: 100%;
            padding: 16px;
            background: #ffffff;
            color: #ef4444;
            border: 2px solid #fecaca;
            border-radius: 16px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.4s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-family: inherit;
        }

        .btn-logout:hover {
            background: #fef2f2;
            border-color: #ef4444;
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(239, 68, 68, 0.2);
        }

        .btn-logout i {
            font-size: 20px;
        }

        .success-message {
            background: #f0fdf4;
            color: #16a34a;
            padding: 14px 18px;
            border-radius: 14px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: 500;
            font-size: 14px;
            border: 1px solid #bbf7d0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .error-message {
            background: #fef2f2;
            color: #dc2626;
            padding: 14px 18px;
            border-radius: 14px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: 500;
            font-size: 14px;
            border: 1px solid #fecaca;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        @media (max-width: 600px) {
            .container {
                padding: 15px;
            }

            .settings-card {
                padding: 25px;
                border-radius: 24px;
            }

            .header {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }

            .profile-pic {
                width: 100px;
                height: 100px;
                font-size: 40px;
            }

            .profile-pic-overlay {
                width: 34px;
                height: 34px;
            }
        }
    </style>
</head>
<body>
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>

    <div class="container">
        <header class="header">
            <a href="/dashboard?id=<%= userId %>&name=<%= encodeURIComponent(name) %>&email=<%= encodeURIComponent(email) %>" class="back-btn">
                <i class="ri-arrow-left-line"></i>
                Back to Feed
            </a>
            <h1 class="page-title">Settings</h1>
        </header>

        <div class="settings-card">
            <% if (success) { %>
                <div class="success-message">
                    <i class="ri-checkbox-circle-line"></i>
                    <%= success %>
                </div>
            <% } %>

            <% if (error) { %>
                <div class="error-message">
                    <i class="ri-error-warning-line"></i>
                    <%= error %>
                </div>
            <% } %>

            <form method="POST" action="/settings/update" enctype="multipart/form-data">
                <input type="hidden" name="userId" value="<%= userId %>">
                <input type="hidden" name="currentName" value="<%= name %>">
                <input type="hidden" name="userEmail" value="<%= email %>">

                <div class="profile-section">
                    <div class="profile-pic-container">
                        <div class="profile-pic" id="profilePicPreview">
                            <% if (profilePic) { %>
                                <img src="/uploads/<%= profilePic %>" alt="Profile" id="previewImage">
                            <% } else { %>
                                <span id="profileInitial"><%= name.charAt(0).toUpperCase() %></span>
                            <% } %>
                        </div>
                        <label for="profilePicInput" class="profile-pic-overlay" title="Change Photo">
                            <i class="ri-camera-line"></i>
                        </label>
                    </div>
                    <p class="profile-name"><%= name %></p>
                    <p class="profile-email"><%= email %></p>
                </div>

                <h3 class="section-title">
                    <i class="ri-user-line"></i>
                    Profile Information
                </h3>

                <div class="form-group">
                    <label for="newName">
                        <i class="ri-edit-line"></i>
                        Display Name
                    </label>
                    <input 
                        type="text" 
                        id="newName" 
                        name="newName" 
                        value="<%= name %>" 
                        placeholder="Enter your name" 
                        required 
                        minlength="2"
                    >
                    <p class="input-hint">This name will be shown on your posts</p>
                </div>

                <div class="form-group">
                    <label for="emailDisplay">
                        <i class="ri-mail-line"></i>
                        Email Address
                    </label>
                    <input 
                        type="email" 
                        id="emailDisplay" 
                        value="<%= email %>" 
                        disabled
                    >
                    <p class="input-hint">Email cannot be changed</p>
                </div>

                <h3 class="section-title">
                    <i class="ri-image-line"></i>
                    Profile Picture
                </h3>

                <div class="form-group">
                    <label for="profilePicInput" class="file-input-label">
                        <i class="ri-upload-cloud-line"></i>
                        Choose Profile Picture
                    </label>
                    <input 
                        type="file" 
                        id="profilePicInput" 
                        name="profilePic" 
                        accept="image/*"
                    >
                    <p class="file-name" id="fileName">No file selected</p>
                    <p class="input-hint">Supported: JPG, PNG, GIF (Max 5MB)</p>
                </div>

                <button type="submit" class="btn-save">
                    <i class="ri-save-line"></i>
                    Save Changes
                </button>
            </form>

            <div class="logout-section">
                <a href="/login" class="btn-logout">
                    <i class="ri-logout-box-line"></i>
                    Logout
                </a>
            </div>
        </div>
    </div>

    <script>
        const fileInput = document.getElementById('profilePicInput');
        const fileName = document.getElementById('fileName');
        const profilePicPreview = document.getElementById('profilePicPreview');
        const profileInitial = document.getElementById('profileInitial');

        fileInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                fileName.textContent = this.files[0].name;

                const reader = new FileReader();
                reader.onload = function(e) {
                    if (profileInitial) {
                        profileInitial.style.display = 'none';
                    }

                    let img = document.getElementById('previewImage');
                    if (!img) {
                        img = document.createElement('img');
                        img.id = 'previewImage';
                        img.alt = 'Profile';
                        profilePicPreview.appendChild(img);
                    }
                    img.src = e.target.result;
                };
                reader.readAsDataURL(this.files[0]);
            } else {
                fileName.textContent = 'No file selected';
            }
        });
    </script>
</body>
</html>