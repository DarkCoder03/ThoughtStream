<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - ThoughtStream</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; min-height: 100vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #f8f9fa 0%, #f3e8ff 50%, #fce7f3 100%); }
        .top-nav { background: rgba(255,255,255,0.98); border-bottom: 1px solid rgba(229,231,235,0.6); padding: 14px 20px; }
        .top-nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: center; }
        .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .logo-icon { width: 42px; height: 42px; background: linear-gradient(135deg, #a855f7, #ec4899); border-radius: 12px; display: flex; align-items: center; justify-content: center; }
        .logo-icon i { font-size: 22px; color: white; }
        .logo-text { font-size: 20px; font-weight: 700; background: linear-gradient(135deg, #a855f7, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .main-content { flex: 1; display: flex; justify-content: center; align-items: center; padding: 40px 20px; }
        .container { background: white; padding: 40px 35px; border-radius: 24px; box-shadow: 0 20px 60px rgba(168,85,247,0.1); border: 1px solid rgba(229,231,235,0.5); width: 100%; max-width: 420px; }
        .container h1 { text-align: center; color: #1a1a2e; margin-bottom: 8px; font-size: 28px; font-weight: 700; }
        .subtitle { text-align: center; color: #6b7280; margin-bottom: 30px; font-size: 15px; }
        .icon-container { text-align: center; margin-bottom: 20px; }
        .icon-circle { width: 80px; height: 80px; background: linear-gradient(135deg, #f3e8ff, #fce7f3); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; }
        .icon-circle i { font-size: 36px; color: #a855f7; }
        .icon-circle.success { background: linear-gradient(135deg, #dcfce7, #bbf7d0); }
        .icon-circle.success i { color: #16a34a; }
        .icon-circle.error { background: linear-gradient(135deg, #fef2f2, #fecaca); }
        .icon-circle.error i { color: #dc2626; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; color: #374151; font-weight: 500; font-size: 14px; }
        .form-group label i { font-size: 16px; color: #a855f7; }
        .form-group input { width: 100%; padding: 14px 16px; border: 2px solid #e5e7eb; border-radius: 12px; font-size: 15px; background: #f9fafb; color: #1a1a2e; font-family: inherit; transition: all 0.3s; }
        .form-group input::placeholder { color: #9ca3af; }
        .form-group input:focus { outline: none; border-color: #a855f7; background: white; box-shadow: 0 0 0 4px rgba(168,85,247,0.1); }
        .input-hint { font-size: 12px; color: #9ca3af; margin-top: 6px; }
        .btn-primary { width: 100%; padding: 16px; background: linear-gradient(135deg, #a855f7, #ec4899); color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(168,85,247,0.3); }
        .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        .btn-secondary { width: 100%; padding: 14px; background: #f3f4f6; color: #374151; border: 2px solid #e5e7eb; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.3s; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 15px; }
        .btn-secondary:hover { background: white; border-color: #a855f7; color: #a855f7; }
        .message { padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 10px; }
        .error-message { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
        .success-message { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
        .password-strength { margin-top: 8px; }
        .strength-bar { height: 4px; background: #e5e7eb; border-radius: 2px; overflow: hidden; }
        .strength-fill { height: 100%; width: 0%; transition: all 0.3s; }
        .strength-fill.weak { width: 33%; background: #ef4444; }
        .strength-fill.medium { width: 66%; background: #f59e0b; }
        .strength-fill.strong { width: 100%; background: #22c55e; }
        .strength-text { font-size: 11px; margin-top: 4px; color: #9ca3af; }
        #loadingState { display: none; text-align: center; padding: 40px 20px; }
        #loadingState.show { display: block; }
        #formState { display: block; }
        #formState.hide { display: none; }
        .spinner { width: 50px; height: 50px; border: 4px solid #e5e7eb; border-top-color: #a855f7; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <nav class="top-nav">
        <div class="top-nav-container">
            <a href="/" class="logo">
                <div class="logo-icon"><i class="ri-bubble-chart-fill"></i></div>
                <span class="logo-text">ThoughtStream</span>
            </a>
        </div>
    </nav>

    <div class="main-content">
        <div class="container">
            <!-- Loading State -->
            <div id="loadingState">
                <div class="spinner"></div>
                <p style="color: #6b7280;">Verifying reset link...</p>
            </div>

            <!-- Error State -->
            <div id="errorState" style="display: none;">
                <div class="icon-container">
                    <div class="icon-circle error">
                        <i class="ri-error-warning-line"></i>
                    </div>
                </div>
                <h1>Link Expired</h1>
                <p class="subtitle" id="errorMessage">The password reset link has expired or is invalid.</p>
                <a href="/forgot-password" class="btn-primary">
                    <i class="ri-restart-line"></i> Request New Link
                </a>
                <a href="/login" class="btn-secondary">
                    <i class="ri-login-box-line"></i> Back to Login
                </a>
            </div>

            <!-- Success State -->
            <% if (typeof success !== 'undefined' && success) { %>
            <div id="successState">
                <div class="icon-container">
                    <div class="icon-circle success">
                        <i class="ri-checkbox-circle-line"></i>
                    </div>
                </div>
                <h1>Password Updated! 🎉</h1>
                <p class="subtitle"><%= success %></p>
                <a href="/login" class="btn-primary">
                    <i class="ri-login-box-line"></i> Login Now
                </a>
            </div>
            <% } %>

            <!-- Error from server -->
            <% if (typeof error !== 'undefined' && error) { %>
            <div id="serverErrorState">
                <div class="icon-container">
                    <div class="icon-circle error">
                        <i class="ri-error-warning-line"></i>
                    </div>
                </div>
                <h1>Error</h1>
                <div class="message error-message">
                    <i class="ri-error-warning-line"></i>
                    <%= error %>
                </div>
                <a href="/forgot-password" class="btn-primary">
                    <i class="ri-restart-line"></i> Request New Link
                </a>
                <a href="/login" class="btn-secondary">
                    <i class="ri-login-box-line"></i> Back to Login
                </a>
            </div>
            <% } %>

            <!-- Form State -->
            <% if (!success && !error) { %>
            <div id="formState">
                <div class="icon-container">
                    <div class="icon-circle">
                        <i class="ri-lock-password-line"></i>
                    </div>
                </div>
                <h1>Set New Password</h1>
                <p class="subtitle">Create a strong password for your account</p>

                <form method="POST" action="/update-password" id="resetForm">
                    <input type="hidden" name="access_token" id="access_token" value="">
                    <input type="hidden" name="refresh_token" id="refresh_token" value="">
                    
                    <div class="form-group">
                        <label><i class="ri-lock-line"></i> New Password</label>
                        <input type="password" name="password" id="password" placeholder="Enter new password" required minlength="6">
                        <div class="password-strength">
                            <div class="strength-bar">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <div class="strength-text" id="strengthText">At least 6 characters</div>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label><i class="ri-lock-password-line"></i> Confirm Password</label>
                        <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm new password" required>
                        <p class="input-hint" id="matchHint"></p>
                    </div>
                    
                    <button type="submit" class="btn-primary" id="submitBtn">
                        <i class="ri-check-line"></i> Update Password
                    </button>
                </form>
                
                <a href="/login" class="btn-secondary">
                    <i class="ri-arrow-left-line"></i> Back to Login
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <script>
        // Only run if form exists (not success/error page)
        const formState = document.getElementById('formState');
        const loadingState = document.getElementById('loadingState');
        const errorState = document.getElementById('errorState');
        
        if (formState) {
            // Show loading first
            formState.style.display = 'none';
            loadingState.classList.add('show');
            
            // Extract tokens from URL hash
            setTimeout(() => {
                const hash = window.location.hash.substring(1);
                let accessToken = '';
                let refreshToken = '';
                
                if (hash) {
                    const params = new URLSearchParams(hash);
                    accessToken = params.get('access_token') || '';
                    refreshToken = params.get('refresh_token') || '';
                    const type = params.get('type');
                    const error = params.get('error');
                    const errorDesc = params.get('error_description');
                    
                    // Handle error in URL
                    if (error) {
                        loadingState.classList.remove('show');
                        errorState.style.display = 'block';
                        document.getElementById('errorMessage').textContent = errorDesc || 'The reset link is invalid or expired.';
                        return;
                    }
                    
                    // Check if it's a recovery type
                    if (accessToken && type === 'recovery') {
                        document.getElementById('access_token').value = accessToken;
                        document.getElementById('refresh_token').value = refreshToken;
                        
                        // Clean URL
                        history.replaceState(null, '', window.location.pathname);
                        
                        // Show form
                        loadingState.classList.remove('show');
                        formState.style.display = 'block';
                        return;
                    }
                }
                
                // Also check query params
                const urlParams = new URLSearchParams(window.location.search);
                accessToken = urlParams.get('access_token') || accessToken;
                refreshToken = urlParams.get('refresh_token') || refreshToken;
                
                if (accessToken) {
                    document.getElementById('access_token').value = accessToken;
                    document.getElementById('refresh_token').value = refreshToken;
                    loadingState.classList.remove('show');
                    formState.style.display = 'block';
                } else {
                    // No token found - show error
                    loadingState.classList.remove('show');
                    errorState.style.display = 'block';
                }
            }, 500);
        }

        // Password strength checker
        const password = document.getElementById('password');
        const confirmPassword = document.getElementById('confirmPassword');
        const strengthFill = document.getElementById('strengthFill');
        const strengthText = document.getElementById('strengthText');
        const matchHint = document.getElementById('matchHint');

        password?.addEventListener('input', function() {
            const val = this.value;
            let strength = 0;
            
            if (val.length >= 6) strength++;
            if (val.length >= 8) strength++;
            if (/[A-Z]/.test(val) && /[0-9]/.test(val)) strength++;
            
            strengthFill.className = 'strength-fill';
            if (strength === 1) {
                strengthFill.classList.add('weak');
                strengthText.textContent = 'Weak';
                strengthText.style.color = '#ef4444';
            } else if (strength === 2) {
                strengthFill.classList.add('medium');
                strengthText.textContent = 'Medium';
                strengthText.style.color = '#f59e0b';
            } else if (strength >= 3) {
                strengthFill.classList.add('strong');
                strengthText.textContent = 'Strong';
                strengthText.style.color = '#22c55e';
            } else {
                strengthText.textContent = 'At least 6 characters';
                strengthText.style.color = '#9ca3af';
            }
        });

        confirmPassword?.addEventListener('input', function() {
            if (this.value === password.value) {
                matchHint.textContent = '✓ Passwords match';
                matchHint.style.color = '#22c55e';
                this.style.borderColor = '#22c55e';
            } else {
                matchHint.textContent = '✗ Passwords do not match';
                matchHint.style.color = '#ef4444';
                this.style.borderColor = '#ef4444';
            }
        });

        // Form submit validation
        document.getElementById('resetForm')?.addEventListener('submit', function(e) {
            const pwd = password.value;
            const cpwd = confirmPassword.value;
            const token = document.getElementById('access_token').value;
            
            if (!token) {
                e.preventDefault();
                alert('Invalid reset link. Please request a new one.');
                window.location.href = '/forgot-password';
                return;
            }
            
            if (pwd.length < 6) {
                e.preventDefault();
                alert('Password must be at least 6 characters!');
                return;
            }
            
            if (pwd !== cpwd) {
                e.preventDefault();
                alert('Passwords do not match!');
                return;
            }
            
            // Disable button
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').innerHTML = '<i class="ri-loader-4-line" style="animation: spin 1s linear infinite;"></i> Updating...';
        });
    </script>
</body>
</html>